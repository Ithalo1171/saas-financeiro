rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    // Cadastro normal: cada pessoa tem acesso apenas ao próprio perfil.
    match /users/{uid} {
      allow get, list: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(uid) && request.resource.data.email == resource.data.email;
      allow delete: if false;

      match /{subcollection}/{item} {
        allow read, write: if isOwner(uid) && subcollection in [
          'transactions', 'goals', 'budgets', 'cards', 'recurrents',
          'notifications', 'academyProgress'
        ];
      }
    }

    // Administração opcional: ainda exige a custom claim admin no Firebase.
    match /authorizedEmails/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /adminAudit/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
